# EditorConfig — https://editorconfig.org
# Keeps editors consistent across OSes and contributors.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

[*.{go,mod,sum}]
indent_style = tab
indent_size = 4

[*.{py,pyi}]
indent_style = space
indent_size = 4
max_line_length = 100

[*.{js,mjs,cjs,ts,tsx,jsx,json,jsonc}]
indent_style = space
indent_size = 2

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
indent_size = 4

[*.{toml,ini,cfg}]
indent_style = space
indent_size = 2

[*.sh]
indent_style = space
indent_size = 2